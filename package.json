{
  "name": "pdf-smart-assistant",
  "version": "1.0.0",
  "description": "AI-Powered PDF & Document Assistant powered by Google Gemini 2.5 Flash with interactive page citations, smart summarization, translation, and floating quick tools.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "build:exe": "npx bun build ./server.ts --compile --define process.env.NODE_ENV='\"production\"' --outfile dist/pdf-smart-assistant.exe"
  },
  "keywords": [
    "pdf",
    "ai-assistant",
    "gemini",
    "gemini-2.5-flash",
    "document-qa",
    "pdf-viewer",
    "word-extractor",
    "react",
    "typescript",
    "vite"
  ],
  "author": "Yaman Şener",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.379.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intersection-observer": "^9.10.2",
    "react-markdown": "^9.0.1",
    "react-pdf": "^9.0.0",
    "tailwind-merge": "^2.3.0",
    "tesseract.js": "^5.1.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
